datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleEnum {
  ADMINISTRADOR
  VENDEDOR
  BODEGA
  LOGISTICA
  SUPERVISOR
}

enum OrderStatusEnum {
  CREADO
  PENDIENTE
  RECIBIDO
  EN_PREPARACION
  PREPARADO
  EN_RUTA
  ENTREGADO
  CANCELADO
  RECHAZADO
  PENDIENTE_DE_STOCK
}

enum ProductStatusEnum {
  DISPONIBLE
  STOCK_BAJO
  AGOTADO
}

enum RouteStatusEnum {
  PLANIFICADA
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  fullName     String
  role         RoleEnum   @default(VENDEDOR)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders        Order[]        @relation("VendorOrders")
  statusHistory OrderStatusHistory[]
  routes        Route[]        @relation("VendorRoutes")
  syncLogs      SyncLog[]
  notifications Notification[]

  @@map("users")
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  nitDocument   String    @unique
  phone         String
  address       String
  municipality  String
  neighborhood  String?
  contactPerson String?
  customerType  String    @default("General")
  lat           Float?
  lng           Float?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  routeCustomers RouteCustomer[]

  @@map("customers")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id            String            @id @default(uuid())
  name          String
  description   String
  characteristics String?
  presentation  String
  unitOfMeasure String            @default("Unidad")
  price         Decimal           @db.Decimal(12, 2)
  stock         Int               @default(0)
  minStock      Int               @default(10)
  status        ProductStatusEnum @default(DISPONIBLE)
  photoUrl      String?
  barcode       String?           @unique
  isActive      Boolean           @default(true)
  categoryId    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  category      Category          @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]

  @@map("products")
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    Int             @default(autoincrement())
  customerId     String
  vendorId       String
  status         OrderStatusEnum @default(CREADO)
  totalAmount    Decimal         @db.Decimal(12, 2)
  notes          String?
  clientCreatedAt DateTime       @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  vendor         User            @relation("VendorOrders", fields: [vendorId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id             String          @id @default(uuid())
  orderId        String
  previousStatus OrderStatusEnum?
  newStatus      OrderStatusEnum
  changedById    String
  notes          String?
  createdAt      DateTime        @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy      User            @relation(fields: [changedById], references: [id])

  @@map("order_status_histories")
}

model Route {
  id          String          @id @default(uuid())
  code        String          @unique
  vendorId    String
  routeDate   DateTime
  vehicle     String?
  zone        String
  status      RouteStatusEnum @default(PLANIFICADA)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendor      User            @relation("VendorRoutes", fields: [vendorId], references: [id])
  customers   RouteCustomer[]

  @@map("routes")
}

model RouteCustomer {
  id         String   @id @default(uuid())
  routeId    String
  customerId String
  visitOrder Int      @default(1)
  visited    Boolean  @default(false)

  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id])

  @@map("route_customers")
}

model SyncLog {
  id           String   @id @default(uuid())
  clientSyncId String   @unique
  userId       String
  action       String
  status       String   @default("SUCCESS")
  errorMessage String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@map("sync_logs")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?
  roleTarget RoleEnum?
  title      String
  body       String
  type       String    // NEW_ORDER, ORDER_STATUS_CHANGE, LOW_STOCK
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id])

  @@map("notifications")
}
